# Beszel agent per-host config. Copy to /etc/beszel/agent.env, fill in the
# values from the Beszel hub's "Add System" dialog
# (https://beszel.dx4homelab.net), then:
#   sudo systemctl daemon-reload && sudo systemctl start beszel-agent
#
# The presence of /etc/beszel/agent.env is what activates beszel-agent.service
# (ConditionPathExists). Keep the real file OUT of git — TOKEN is a secret.

LISTEN=45876
# Hub public key (whole string incl. the "ssh-ed25519 " prefix):
KEY=ssh-ed25519 REPLACE_WITH_HUB_PUBLIC_KEY
# Per-system token the hub generated for THIS host:
TOKEN=REPLACE_WITH_PER_SYSTEM_TOKEN
HUB_URL=https://beszel.dx4homelab.net

# Optional: pin the OS disk for "root" disk I/O so the agent doesn't
# auto-guess the busiest device (host-specific, e.g. FILESYSTEM=nvme0n1p3):
# FILESYSTEM=
